# Build outputs and the fetched SDK jar (see README.md).
build/
out/
sdk/
*.apk
*.idsig

# The repo root .gitignore blanket-ignores AndroidManifest.xml (from an old maven setup);
# this one is a real source file.
!AndroidManifest.xml

# Legacy personal music stays local and is excluded from builds.
# Committing it would redistribute someone else's recording.
res/raw/bgm.*

# Play upload bundles and private signing material.
*.aab
*.apks
.private/

# Optional Play SDK dependency resolver caches.
.gradle/
__pycache__/
tools/play-deps/.gradle/
tools/play-deps/build/

# Fastlane dependencies, generated reports and local Play credentials.
.bundle/
vendor/bundle/
fastlane/report.xml
fastlane/README.md
fastlane/.env*
*.p8
*.p12
*.mobileprovision
