# Build outputs and the fetched SDK jar (see README.md).
build/
out/
sdk/
*.apk
*.idsig

# The repo root .gitignore blanket-ignores AndroidManifest.xml (from an old maven setup);
# this one is a real source file.
!AndroidManifest.xml

# A user-supplied music track stays local: res/raw/bgm.* is played if present, but
# committing it would redistribute someone else's recording.
res/raw/bgm.*

# Play upload bundles and private signing material.
*.aab
*.apks
.private/

# Optional Play SDK dependency resolver caches.
.gradle/
__pycache__/
