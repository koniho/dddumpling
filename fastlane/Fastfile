require "json"
require "rexml/document"
require "fileutils"
require "tmpdir"

def play_credentials
  credentials = ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON", "")
  UI.user_error!("Set GitHub secret GOOGLE_PLAY_SERVICE_ACCOUNT_JSON; see app-store/play-publishing.md") if credentials.empty?
  begin
    key = JSON.parse(credentials)
  rescue JSON::ParserError
    UI.user_error!("Google Play credentials must be a valid service-account JSON key")
  end
  unless key["type"] == "service_account" && key["client_email"] && key["private_key"]
    UI.user_error!("Google Play credentials must be a service-account JSON key")
  end
  credentials
end

def play_test_track(channel)
  return "internal" if channel == "internal"
  UI.user_error!("Testing channel must be closed or internal") unless channel == "closed"
  track = ENV.fetch("PLAY_CLOSED_TRACK", "alpha").strip
  track = "alpha" if track.empty?
  if ["production", "beta", "internal"].include?(track) || track.include?(":")
    UI.user_error!("PLAY_CLOSED_TRACK must identify a closed testing track")
  end
  track
end

def play_upload_options(root, channel = "closed")
  manifest = REXML::Document.new(File.read(File.join(root, "AndroidManifest.xml"))).root
  package = manifest.attributes["package"]
  UI.user_error!("Unexpected Android package") unless package == "com.dddumpling.game"
  version = manifest.attributes["android:versionCode"]
  name = manifest.attributes["android:versionName"]
  ref = ENV.fetch("GITHUB_REF", "")
  if ref.start_with?("refs/tags/") && ref != "refs/tags/v#{name}"
    UI.user_error!("Release tag must match AndroidManifest.xml versionName: v#{name}")
  end
  notes = File.join(root, "app-store/google-play/en-US/changelogs", "#{version}.txt")
  UI.user_error!("Add release notes at #{notes}") unless File.file?(notes)
  text = File.read(notes).strip
  UI.user_error!("Release notes must contain 1–500 characters") unless (1..500).cover?(text.length)
  aab = File.join(root, "build/DDDUMPLING.aab")
  UI.user_error!("Build or download the signed production AAB first") unless File.file?(aab)
  credentials = play_credentials
  metadata = Dir.mktmpdir("play-notes-", File.join(root, "build"))
  destination = File.join(metadata, "en-US", "changelogs")
  FileUtils.mkdir_p(destination)
  FileUtils.cp(notes, File.join(destination, "#{version}.txt"))
  {
    package_name: package,
    json_key_data: credentials,
    aab: aab,
    track: play_test_track(channel),
    release_status: "completed",
    version_name: "#{name} (#{version})",
    metadata_path: metadata,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: false
  }
end

default_platform(:android)
platform :android do
  desc "Verify Google Play access without uploading or publishing"
  lane :verify_access do
    require "supply"
    client = Supply::Client.make_from_config(params: { json_key_data: play_credentials, timeout: 300 })
    begin
      client.begin_edit(package_name: "com.dddumpling.game")
      UI.message("Uploaded AAB version codes: #{client.aab_version_codes.join(', ')}")
      UI.message("Uploaded APK version codes: #{client.apks_version_codes.join(', ')}")
      tracks = client.tracks
      tracks.each do |track|
        versions = Array(track.releases).flat_map { |release| Array(release.version_codes) }
        UI.message("Play track #{track.track}: version codes #{versions.join(', ')}")
      end
      target = play_test_track("closed")
      UI.user_error!("Closed track #{target} not found. Create it in Play Console or set PLAY_CLOSED_TRACK.") unless tracks.any? { |track| track.track == target }
      UI.success("Google Play access verified. Closed upload target: #{target}")
    ensure
      client.abort_current_edit if client.current_edit
    end
  end

  desc "Upload the signed production bundle to the selected testing channel"
  lane :testing do
    channel = ENV.fetch("PLAY_TEST_CHANNEL", "closed")
    upload_to_play_store(**play_upload_options(File.expand_path("..", __dir__), channel))
  end

  desc "Upload the signed production bundle and release notes to internal testing"
  lane :internal do
    upload_to_play_store(**play_upload_options(File.expand_path("..", __dir__), "internal"))
  end
end
